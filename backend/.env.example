# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://quitly:quitly_pass@localhost:5432/quitly_db

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (RS256) ───────────────────────────────────────
# Run: npm run keys:gen  to generate these
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Email (Nodemailer) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Quitly <no-reply@quitly.app>"

# ─── Firebase (FCM) ────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Anthropic (Claude AI) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024

# ─── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20

# ─── Security ──────────────────────────────────────────
BCRYPT_ROUNDS=12
REFRESH_TOKEN_SECRET=change-me-random-32-chars-min

# ─── BullMQ ────────────────────────────────────────────
BULLMQ_PREFIX=quitly

# ─── Logging ───────────────────────────────────────────
LOG_LEVEL=info
